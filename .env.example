# Lovable Cloud (managed automatically; public browser values are safe to expose)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Managed platform services
LOVABLE_API_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# NIM Panic network configuration (testnet only)
# Override the default public endpoint with a private/dedicated node for better reliability.
NIMIQ_RPC_URL=https://rpc-testnet.nimiqwatch.com
# Optional HTTP Basic auth for the RPC node: "user:password"
NIMIQ_RPC_AUTH=

# NIM Panic treasury and operator configuration
# NIMIQ_RPC_URL must be set to a node that holds the treasury key as an
# unlocked hot-wallet (imported without a passphrase lock). No passphrase is
# required or used by this application — the node manages key custody.
NIM_PANIC_TREASURY_ADDRESS=
NIM_PANIC_ADMIN_ADDRESSES=