# Lovable Cloud (managed automatically; public browser values are safe to expose)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Managed platform services
LOVABLE_API_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# NIM Panic network configuration
NIMIQ_NETWORK=test
NIMIQ_RPC_URL_TEST=https://rpc-testnet.nimiqwatch.com
NIMIQ_RPC_URL_MAIN=https://rpc.nimiqwatch.com
NIMIQ_RPC_AUTH=

# NIM Panic treasury and operator configuration
# Store the passphrase as an encrypted runtime secret, never in a committed .env file.
NIM_PANIC_TREASURY_ADDRESS=
NIM_PANIC_TREASURY_WALLET_PASSPHRASE=
NIM_PANIC_ADMIN_ADDRESSES=